<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              App Links for the payment result pages.

              WHY: paying opens the gateway, and the gateway is a different origin, so Capacitor
              hands it to Chrome. When the gateway then redirects to our own cancel/return URL,
              Android had nothing registered and kept the user in Chrome — stranded in a browser
              with no session, while the app sat on the payment screen behind it. This filter is
              what lets Android hand those two URLs back to the app.

              SCOPED TO /payment ON PURPOSE. Without pathPrefix this would swallow every
              bari360.space link on the device, so sharing /plans or /terms with a friend who has
              the app installed would open the app instead of a web page. Only the two URLs the
              gateway sends people to belong to the app.

              autoVerify needs https://www.bari360.space/.well-known/assetlinks.json to list this
              package and the RELEASE keystore's SHA-256. Verification is silent when it fails —
              links simply keep opening in the browser — so check it with:
                  adb shell pm get-app-links com.rentmaster.app

              MainActivity is launchMode="singleTask" (above), so this arrives through onNewIntent
              on the existing task rather than starting a second copy of the app.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="www.bari360.space"
                    android:pathPrefix="/payment" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- FCM: use the RentMaster logo silhouette as the status-bar notification icon,
             tinted with the brand color. Applies to background/data notifications. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
        <!-- Fallback channel for a push that arrives before the app has ever been opened, i.e.
             before lib/native-push.ts has had a chance to create the real channels. Android would
             otherwise invent a "Miscellaneous" channel with the system default sound.

             A LITERAL string, not @string/… — the Firebase SDK reads this with Bundle.getString(),
             which returns null for a metadata entry stored as a resource reference.

             Keep in step with SOUND_CHANNELS in the backend's lib/fcm-send.ts and with
             createSoundChannels() in lib/native-push.ts. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="bari360_tone_v1" />
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ runtime notification permission (FCM). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Install the downloaded APK when the user taps "Upgrade". -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
