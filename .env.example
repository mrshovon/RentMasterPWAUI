# Bari360 frontend (rent-master-pwa-ui) — copy to .env.local and fill in.
# NEXT_PUBLIC_* values are inlined at BUILD time — rebuild if they change.

# Deployed backend base URL (rent-master-pwa). Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_API_BASE=https://your-backend-domain.com

# Public origin this frontend is served from. Also baked into the Android shell as the URL its
# WebView loads (see capacitor.config.js) — set it as a GitHub repo secret too, or the release
# workflow falls back to the hardcoded default.
NEXT_PUBLIC_APP_URL=https://www.bari360.space

# Web Push public VAPID key — MUST match the backend's NEXT_PUBLIC_VAPID_PUBLIC_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Supabase — public URL + anon key (same values as the backend). Used ONLY by the
# /reset-password page's browser client to consume the password-recovery link. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
